# =============================================================================
# MINI JARVIS - Environment Configuration (.env)
# =============================================================================
# Copy this file to '.env' and fill in your values if desired.
# Note: Jarvis works out of the box even without any API keys thanks to its
# built-in offline CSE brain and local tools!
# =============================================================================

# LLM API Key (OpenAI, Groq, or OpenRouter)
OPENAI_API_KEY=

# Optional Custom Base URL (leave blank for default OpenAI)
# For FREE Groq: https://api.groq.com/openai/v1
# For Local Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=

# Model Name
# OpenAI default: gpt-4o-mini
# Groq recommendation: llama-3.3-70b-versatile
# Ollama recommendation: llama3.2
LLM_MODEL=gpt-4o-mini
